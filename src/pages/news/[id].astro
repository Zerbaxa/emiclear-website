---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";

export async function getStaticPaths() {
  const entries = await getCollection("news", ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<"news"> }
const { entry } = Astro.props;
const { Content } = await render(entry);
const date = new Intl.DateTimeFormat("ko-KR", { dateStyle: "long" }).format(entry.data.publishedAt);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <PageHero eyebrow={date} title={entry.data.title} description={entry.data.summary} />
  <article class="section"><div class="container prose"><Content /></div></article>
</BaseLayout>

