---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import { categories, audienceLabelEn, stripEn } from "../../../data/education-topics";

const published = await getCollection(
  "education",
  ({ data }) => !data.draft && data.lang === "en"
);

const formatDate = (d: Date) =>
  new Intl.DateTimeFormat("en-GB", { dateStyle: "long" }).format(d);

const sections = categories.map((category) => {
  const entries = category.topics.flatMap((topic) =>
    published
      .filter((e) => e.data.topic === topic.slug)
      .map((entry) => ({ entry, topic }))
  );
  const planned = category.topics.filter(
    (topic) => !published.some((e) => e.data.topic === topic.slug)
  );
  return { category, entries, planned };
});
---

<BaseLayout lang="en" title="Resources" description="Reviewed education resources on childhood injury — what to do at home, when to go to hospital, and how to prevent it. Evidence and review dates attached.">
  <PageHero eyebrow="Resources" title="We publish only what has been reviewed." description="What to do when a child is hurt, and when to go to hospital. Every resource carries its references and its review dates." />

  {sections.map(({ category, entries, planned }) => (
    <section class="section" id={category.id}>
      <div class="container">
        <div class="section-heading" data-reveal>
          <p class="section-label">{category.labelEn}</p>
          <h2>{category.descriptionEn}</h2>
        </div>

        <ul class="topic-grid" data-reveal>
          {entries.map(({ entry, topic }) => (
            <li class="topic-card">
              <a href={`/en/education/${stripEn(entry.id)}/`}>
                <p class="topic-card__eyebrow">
                  <span>{topic.labelEn}</span>
                  <span class="topic-card__badge">{audienceLabelEn[entry.data.audience]}</span>
                </p>
                <h3>{entry.data.title}</h3>
                <p class="topic-card__summary">{entry.data.summary}</p>
                <p class="topic-card__meta">Reviewed {formatDate(entry.data.reviewedAt)}</p>
              </a>
            </li>
          ))}

          {planned.map((topic) => (
            <li class="topic-card topic-card--planned">
              <p class="topic-card__eyebrow">
                <span>{topic.labelEn}</span>
                <span class="topic-card__badge">In preparation</span>
              </p>
              <p class="topic-card__summary">Published once review is complete.</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section section--alt">
    <div class="container content-grid">
      <h2>How we handle<br />our resources.</h2>
      <div class="prose" data-reveal>
        <p class="section-label">Principles</p>
        <div class="notice">
          <strong>Medical information notice</strong>
          <p>Resources on this site are for general information and do not replace diagnosis or treatment for any individual. In an emergency, call 119 or go to the nearest emergency department.</p>
        </div>
        <div class="principles">
          <article class="principle">
            <h3>Evidence and review dates travel with the resource</h3>
            <p>Every resource carries its references, its publication date, its last review date and the date of the next scheduled review. Medical information changes over time. Drafts that have not completed review are not published.</p>
          </article>
          <article class="principle">
            <h3>Two versions of the same topic</h3>
            <p>The caregiver version uses plain language and clear actions. The clinician version states scope and limitations. Both are written from a single evidence review, so they do not contradict each other.</p>
          </article>
          <article class="principle">
            <h3>Published in the name of the organization</h3>
            <p>We do not publish the names of individual authors or reviewers. These resources are issued as the reviewed position of the organization, not as personal opinion.</p>
          </article>
          <article class="principle">
            <h3>No derivatives</h3>
            <p>Educational content is provided under CC BY-NC-ND 4.0. Reviewed material should not be edited and recirculated in another context. Where a translation is needed, EM-I-CLEAR provides a reviewed translation directly — write to contact@emiclear.org.</p>
          </article>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
