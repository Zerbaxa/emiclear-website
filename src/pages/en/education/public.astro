---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import EmptyState from "../../../components/EmptyState.astro";
---

<BaseLayout lang="en" title="Education for Patients and Caregivers" description="Reviewed emergency care information for patients, caregivers and the public.">
  <PageHero eyebrow="For the Public" title="Education for patients and caregivers" description="Clear information to help people understand emergencies and seek appropriate assistance." />
  <section class="section">
    <div class="container">
      <div class="notice"><strong>Medical information notice</strong><p>Resources on this site provide general education and do not replace individual diagnosis or treatment. In an emergency, contact your local emergency services or seek care at the nearest emergency facility.</p></div>
      <div style="height:1.5rem"></div>
      <EmptyState title="Resources are in preparation" description="English-language information will be published after internal review and approval." />
    </div>
  </section>
</BaseLayout>

