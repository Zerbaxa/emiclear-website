---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import { categories, audienceLabelEn, stripEn } from "../../../data/education-topics";

export async function getStaticPaths() {
  const entries = await getCollection(
    "education",
    ({ data }) => !data.draft && data.lang === "en"
  );
  // 파일은 `<topic>-<audience>-en.md` 지만 URL 에서는 접미사를 뗀다.
  // 그래야 /education/burn-public/ ↔ /en/education/burn-public/ 로 언어 전환이 맞는다.
  return entries.map((entry) => ({ params: { id: stripEn(entry.id) }, props: { entry } }));
}

interface Props { entry: CollectionEntry<"education"> }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-GB", { dateStyle: "long" }).format(date);

const toc = headings.filter((h) => h.depth === 2);
const category = categories.find((c) =>
  c.topics.some((t) => t.slug === entry.data.topic)
);
const topic = category?.topics.find((t) => t.slug === entry.data.topic);

// 국문판이 실제로 있을 때만 언어 전환 링크를 띄운다.
const koreanEntries = await getCollection(
  "education",
  ({ data }) => !data.draft && data.lang === "ko"
);
const hasKorean = koreanEntries.some((e) => e.id === stripEn(entry.id));
---

<BaseLayout lang="en" title={entry.data.title} description={entry.data.summary} hasTranslation={hasKorean}>
  <PageHero eyebrow={`${topic?.labelEn ?? entry.data.topic} · ${audienceLabelEn[entry.data.audience]}`} title={entry.data.title} description={entry.data.summary} />

  <article class="section entry">
    <div class="container content-grid">
      <aside class="entry-side">
        {toc.length > 1 && (
          <nav class="entry-toc" aria-label="Contents">
            <h2 class="entry-meta-title">Contents</h2>
            <ol>
              {toc.map((h) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </nav>
        )}

        <h2 class="entry-meta-title">About this resource</h2>
        <dl>
          {category && <><dt>Category</dt><dd>{category.labelEn}</dd></>}
          <dt>Audience</dt><dd>{audienceLabelEn[entry.data.audience]}</dd>
          <dt>Published</dt><dd>{formatDate(entry.data.publishedAt)}</dd>
          <dt>Last reviewed</dt><dd>{formatDate(entry.data.reviewedAt)}</dd>
          <dt>Next review</dt><dd>{formatDate(entry.data.nextReviewAt)}</dd>
        </dl>

        {entry.data.pdf && (
          <a class="button button-solid entry-pdf" href={entry.data.pdf} download>
            Download PDF
            {entry.data.pdfEdition && <small>{entry.data.pdfEdition}</small>}
          </a>
        )}
      </aside>

      <div class="prose entry-body">
        <p class="entry-reviewed"><strong>Reviewed by EM-I-CLEAR</strong></p>
        <Content />

        {entry.data.references.length > 0 && (
          <section class="entry-refs">
            <h2>References</h2>
            <ol>
              {entry.data.references.map((ref) => <li>{ref}</li>)}
            </ol>
          </section>
        )}

        <div class="notice">
          <strong>Medical disclaimer</strong>
          <p>This resource is provided for general education and does not replace diagnosis or treatment for any individual.</p>
        </div>
        <p><small>This educational content is provided under CC BY-NC-ND 4.0.</small></p>
        <p class="entry-back"><a class="arrow-link" href="/en/education/">See other resources <span aria-hidden="true">↗</span></a></p>
      </div>
    </div>
  </article>
</BaseLayout>
