---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
---

<BaseLayout lang="en" title="About" description="EM-I-CLEAR is a mission-driven, independent nonprofit association based in the Republic of Korea.">
  <PageHero eyebrow="About Our Nonprofit" title="Care should reach everyone." description="EM-I-CLEAR is an independent nonprofit connecting people to needed care through education, research, and responsible technology." />
  <section class="section">
    <div class="container content-grid">
      <h2>EM-I-CLEAR</h2>
      <div class="prose">
        <p><strong>EM-I-CLEAR</strong> stands for <span lang="en">Emergency Medicine Initiative for Clinical Learning, Education, Artificial Intelligence, and Research</span>.</p>
        <p class="section-label about-focus-label">Our focus</p>
        <p class="about-focus">We narrow the gap in care.</p>
        <p>We help people reach the knowledge and appropriate support they need, when they need it.</p>
        <div class="about-activities">
          <p class="section-label">What we do</p>
          <div class="principles">
            <article class="principle"><h3>Education</h3><p>We educate healthcare providers, teachers, and the public to support better care and more appropriate use of healthcare.</p></article>
            <article class="principle"><h3>Research</h3><p>We develop educational tools, conduct academic research, and convene conferences and workshops for better care.</p></article>
            <article class="principle"><h3>Technology</h3><p>We use AI and other technologies to lower geographic, language, and cultural barriers and expand people’s experience of care.</p></article>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
