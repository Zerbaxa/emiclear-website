---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
---

<BaseLayout lang="en" title="About" description="About EM-I-CLEAR and its purpose in emergency care.">
  <PageHero eyebrow="About Our Nonprofit" title="Public-interest work for clearer, better emergency care" description="EM-I-CLEAR is a nonprofit group dedicated to responsible education, field-focused research and practical innovation in emergency care." />
  <section class="section">
    <div class="container content-grid">
      <h2>What we do</h2>
      <div class="prose">
        <p><strong>EM-I-CLEAR</strong> stands for <span lang="en">Emergency Medicine Innovation — Clinical Learning, Education and Research</span>.</p>
        <p>Emergency care depends on timely decisions and effective collaboration. As a nonprofit group, we connect important questions from the field with education and research, then share reviewed findings in forms that are clear, useful and publicly accessible.</p>
        <div class="principles">
          <article class="principle"><h3>Nonprofit purpose</h3><p>Our work serves education, research and the public interest rather than private profit. Public resources are offered without a membership or payment requirement.</p></article>
          <article class="principle"><h3>Evidence-informed</h3><p>Public resources include supporting evidence, references, review dates and planned review dates.</p></article>
          <article class="principle"><h3>Audience-focused</h3><p>Healthcare professionals, patients and caregivers receive information written for their different needs.</p></article>
          <article class="principle"><h3>Responsible publication</h3><p>Only internally reviewed and approved resources are published. Personal data and internal administrative records remain private.</p></article>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
