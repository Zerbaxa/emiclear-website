---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout lang="en" title="EM-I-CLEAR" description="Education, research and innovation for better emergency care.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Clarity for Emergency Care</p>
        <h1>Education, research and innovation for better emergency care</h1>
        <p>EM-I-CLEAR connects experience from emergency care with evidence, creating reliable education and field-focused research that support meaningful change.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/en/education/">Explore education</a>
          <a class="button button-secondary" href="/en/about/">About the group</a>
        </div>
      </div>
      <div class="signal-panel" aria-hidden="true"><span class="signal-line"></span></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Our Principles</p>
        <h2>Sharing reliable information responsibly</h2>
        <p>We apply the same clear standards to every resource we publish.</p>
      </div>
      <div class="card-grid">
        <article class="card"><p class="card-number">01</p><h3>Transparent evidence</h3><p>Key statements and recommendations are presented with their evidence and references.</p></article>
        <article class="card"><p class="card-number">02</p><h3>Defined audiences</h3><p>Information is written for the distinct needs of healthcare professionals, patients and caregivers.</p></article>
        <article class="card"><p class="card-number">03</p><h3>Ongoing review</h3><p>Resources include review dates and are updated as relevant evidence changes.</p></article>
      </div>
    </div>
  </section>

  <section class="section" style="background: #fff;">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">Education Pathways</p><h2>Find information for your needs</h2></div>
      <div class="audience-grid">
        <a class="audience-card" href="/en/education/clinicians/"><p class="eyebrow">For Clinicians</p><h3>Healthcare professionals</h3><p>Evidence-informed resources with references, scope and review information for emergency care practice.</p></a>
        <a class="audience-card" href="/en/education/public/"><p class="eyebrow">For the Public</p><h3>Patients and caregivers</h3><p>Clear information to help people understand emergencies and seek appropriate care.</p></a>
      </div>
    </div>
  </section>
</BaseLayout>

