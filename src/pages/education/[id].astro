---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";

export async function getStaticPaths() {
  const entries = await getCollection("education", ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<"education"> }
const { entry } = Astro.props;
const { Content } = await render(entry);
const formatDate = (date: Date) => new Intl.DateTimeFormat("ko-KR", { dateStyle: "long" }).format(date);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <PageHero eyebrow={entry.data.audience === "clinicians" ? "For Clinicians" : "For Public"} title={entry.data.title} description={entry.data.summary} />
  <article class="section">
    <div class="container content-grid">
      <aside>
        <h2 style="font-size:1.4rem">자료 정보</h2>
        <dl>
          <dt>주제</dt><dd>{entry.data.topic}</dd>
          <dt>자료 유형</dt><dd>{entry.data.materialType}</dd>
          <dt>게시일</dt><dd>{formatDate(entry.data.publishedAt)}</dd>
          <dt>최종 검토일</dt><dd>{formatDate(entry.data.reviewedAt)}</dd>
          <dt>다음 검토예정일</dt><dd>{formatDate(entry.data.nextReviewAt)}</dd>
        </dl>
      </aside>
      <div class="prose">
        <p><strong>EM-I-CLEAR 내부 검토 완료</strong></p>
        <Content />
        <div class="notice"><strong>의료정보 면책</strong><p>이 자료는 일반적인 교육 목적으로 제공되며 개인의 진단이나 치료를 대신하지 않습니다.</p></div>
        <p><small>이 교육 콘텐츠는 CC BY-NC-ND 4.0 조건으로 제공됩니다.</small></p>
      </div>
    </div>
  </article>
</BaseLayout>

