---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
---

<BaseLayout title="교육자료" description="의료 제공자와 시민·교사를 위한 교육자료">
  <PageHero eyebrow="Education" title="응급의료 교육자료" description="보건의료인과 일반인·보호자를 위한 교육 경로를 제공합니다." />
  <section class="section">
    <div class="container audience-grid">
      <a class="audience-card" href="/education/clinicians/"><p class="eyebrow">For Clinicians</p><h3>보건의료인용 자료</h3><p>의료 제공자를 위한 교육자료와 근거 요약입니다.</p></a>
      <a class="audience-card" href="/education/public/"><p class="eyebrow">For Public</p><h3>일반인·보호자용 자료</h3><p>시민·보호자·교사가 의료 이용과 건강관리를 이해하는 데 도움이 되는 안내입니다.</p></a>
    </div>
  </section>
</BaseLayout>
