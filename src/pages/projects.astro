---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import EmptyState from "../components/EmptyState.astro";
---

<BaseLayout title="연구·프로젝트" description="EM-I-CLEAR의 응급의료 연구와 혁신 프로젝트">
  <PageHero eyebrow="Research & Projects" title="현장의 질문을 연구와 변화로" description="교육, 임상 절차, 현장 초음파와 기술 기반 개선을 포함한 응급의료 프로젝트를 소개합니다." />
  <section class="section"><div class="container"><EmptyState title="프로젝트를 정리하고 있습니다" description="공개가 승인된 연구와 프로젝트부터 목적, 진행 상태와 결과를 소개하겠습니다." /></div></section>
</BaseLayout>

