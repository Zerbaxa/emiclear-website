---
interface Props { lang?: "ko" | "en"; overlay?: boolean; hasTranslation?: boolean }
const { lang = "ko", overlay = false, hasTranslation = true } = Astro.props;
const isEnglish = lang === "en";
/** 자료는 대상이 갈리므로 하위 메뉴로 펼친다. 나머지는 단일 링크. */
const navigation = isEnglish
  ? [
      { href: "/en/about/", label: "About" },
      {
        href: "/en/education/",
        label: "Resources",
        children: [
          { href: "/en/education/for-caregivers/", label: "For caregivers", note: "Plain-language guidance" },
          { href: "/en/education/for-clinicians/", label: "For clinicians", note: "Scope, limits and PDF" },
        ],
      },
      { href: "/en/projects/", label: "What we do", cta: true },
    ]
  : [
      { href: "/about/", label: "소개" },
      {
        href: "/education/",
        label: "자료",
        children: [
          { href: "/education/for-caregivers/", label: "보호자용", note: "쉬운 말로 쓴 행동 안내" },
          { href: "/education/for-clinicians/", label: "의료인용", note: "적용 범위와 한계, PDF" },
        ],
      },
      { href: "/projects/", label: "교육·연구", cta: true },
    ];

const pathname = Astro.url.pathname;
const homeHref = isEnglish ? "/en/" : "/";
const languageHref = isEnglish
  ? pathname.replace(/^\/en(?=\/|$)/, "") || "/"
  : `/en${pathname === "/" ? "/" : pathname}`;
---

<header class:list={["site-header", { "site-header--overlay": overlay }]}>
  <a class="skip-link" href="#main-content">{isEnglish ? "Skip to content" : "본문 바로가기"}</a>
  <div class="header-inner container">
    <a class="wordmark" href={homeHref} aria-label={isEnglish ? "EM-I-CLEAR home" : "EM-I-CLEAR 홈"}>
      <img class="brand-mark brand-mark--color" src="/brand/emiclear-mark.svg" alt="" width="32" height="32" />
      <img class="brand-mark brand-mark--white" src="/brand/emiclear-mark-white.svg" alt="" width="32" height="32" />
      <span class="wordmark-text">
        <span class="wordmark-main">EM-I-CLEAR</span>
        {!isEnglish && <span class="wordmark-ko">응급의학혁신교육연구회</span>}
      </span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
      <span class="sr-only">{isEnglish ? "Open menu" : "메뉴 열기"}</span>
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
    <nav id="primary-navigation" class="primary-nav" aria-label={isEnglish ? "Primary navigation" : "주요 메뉴"}>
      {navigation.map((item) =>
        item.children ? (
          <div class="nav-group">
            <a
              class:list={["nav-group__parent", { "is-section": pathname.startsWith(item.href) }]}
              href={item.href}
              aria-current={pathname === item.href ? "page" : undefined}
            >
              {item.label}
              <svg class="nav-group__caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1L5 5L9 1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <div class="nav-submenu">
              {item.children.map((child) => (
                <a href={child.href} aria-current={pathname === child.href ? "page" : undefined}>
                  <span class="nav-submenu__label">{child.label}</span>
                  <span class="nav-submenu__note">{child.note}</span>
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a class:list={{ "nav-cta": item.cta }} href={item.href} aria-current={pathname === item.href ? "page" : undefined}>{item.label}</a>
        )
      )}
      {hasTranslation && (
        <a class="language-link" href={languageHref} hreflang={isEnglish ? "ko" : "en"} lang={isEnglish ? "ko" : "en"}>{isEnglish ? "KO" : "EN"}</a>
      )}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const navigation = document.querySelector<HTMLElement>("#primary-navigation");

  const closeMenu = () => {
    toggle?.setAttribute("aria-expanded", "false");
    navigation?.classList.remove("is-open");
  };

  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));
    navigation?.classList.toggle("is-open", !expanded);
  });

  navigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (event) => event.key === "Escape" && closeMenu());
</script>
