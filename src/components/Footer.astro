---
interface Props { lang?: "ko" | "en" }
const { lang = "ko" } = Astro.props;
const isEnglish = lang === "en";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="footer-brand-line">
        <img src="/brand/emiclear-mark-white.svg" alt="" width="38" height="38" />
        <p class="footer-wordmark">EM-I-CLEAR</p>
      </div>
      <p class="footer-local-name">{isEnglish ? "Emergency Medicine Initiative for Clinical Learning, Education, Artificial Intelligence, and Research" : "응급의학혁신교육연구회"}</p>
      <p class="footer-note">{isEnglish ? "Independent nonprofit association · Republic of Korea" : "비영리 임의단체"}</p>
      <p class="footer-note">{isEnglish ? "Unique Registration No. 614-82-76493 · National Tax Service, Republic of Korea" : "고유번호 614-82-76493 · 동작세무서"}</p>
    </div>
    <div class="footer-message">
      <p class="footer-kicker">{isEnglish ? "For a world where no one has to suffer." : "아무도 아프지 않은 세상을 위해."}</p>
      <p>{isEnglish ? "We close the gap that the system leaves between people who need care and those who can give it." : "갑자기 아픈 사람이 도움에 닿기까지, 시스템이 남긴 틈을 메웁니다."}</p>
    </div>
    <div class="footer-links">
      <a href={isEnglish ? "/en/about/" : "/about/"}>{isEnglish ? "About" : "소개"}</a>
      <a href={isEnglish ? "/en/education/" : "/education/"}>{isEnglish ? "Resources" : "자료"}</a>
      <a href={isEnglish ? "/en/projects/" : "/projects/"}>{isEnglish ? "Education & Research" : "교육·연구"}</a>
      <a href="mailto:contact@emiclear.org">contact@emiclear.org</a>
      <a href="https://instagram.com/em.i.clear" rel="me noopener" target="_blank">@em.i.clear</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} EM-I-CLEAR · {isEnglish ? "Maebong-ro, Dongjak-gu, Seoul, Republic of Korea" : "서울특별시 동작구 매봉로"}</p>
    <p>{isEnglish ? "Educational content: CC BY-NC-ND 4.0 · Site code: MIT" : "교육 콘텐츠: CC BY-NC-ND 4.0 · 사이트 코드: MIT"}</p>
  </div>
</footer>
