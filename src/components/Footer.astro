---
interface Props { lang?: "ko" | "en" }
const { lang = "ko" } = Astro.props;
const isEnglish = lang === "en";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-wordmark">EM-I-CLEAR</p>
      <p class="footer-local-name">{isEnglish ? "Emergency Medicine Innovation — Clinical Learning, Education and Research" : "응급의학혁신교육연구회"}</p>
    </div>
    <div>
      <p>{isEnglish ? "A nonprofit group connecting questions from emergency care with reviewed knowledge and practical education." : "현장의 질문을 검토된 지식과 실천 가능한 교육으로 연결합니다."}</p>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} EM-I-CLEAR</p>
    <p>{isEnglish ? "Educational content: CC BY-NC-ND 4.0 · Site code: MIT" : "교육 콘텐츠: CC BY-NC-ND 4.0 · 사이트 코드: MIT"}</p>
  </div>
</footer>
